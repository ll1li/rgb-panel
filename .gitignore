# runtime state and logs
settings.json
panel.log
app-src.log
app-src.err

# build downloads and test logs
build/jom.zip
build/*.err
build/*.out

# machine-specific notes and labels stay local; labels.example.json is the template
NOTES.local.md
labels.json
