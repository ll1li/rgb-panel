+/*---------------------------------------------------------*\
+| RGBController_MSIGPUPascal.h                              |
+|                                                           |
+|   RGBController for MSI Pascal-era Gaming X GPUs          |
+|                                                           |
+|   This file is part of the OpenRGB project                |
+|   SPDX-License-Identifier: GPL-2.0-or-later               |
+\*---------------------------------------------------------*/
+
+#pragma once
+
+#include "RGBController.h"
+#include "MSIGPUPascalController.h"
+
+class RGBController_MSIGPUPascal : public RGBController
+{
+public:
+    RGBController_MSIGPUPascal(MSIGPUPascalController* controller_ptr);
+    ~RGBController_MSIGPUPascal();
+
+    void        SetupZones();
+    void        ResizeZone(int zone, int new_size);
+
+    void        DeviceUpdateLEDs();
+    void        UpdateZoneLEDs(int zone);
+    void        UpdateSingleLED(int led);
+
+    void        DeviceUpdateMode();
+
+private:
+    MSIGPUPascalController* controller;
+    std::chrono::time_point<std::chrono::steady_clock> last_commit_time;
+
+    bool        TimeToSend();
+    void        SendColors();
+};
